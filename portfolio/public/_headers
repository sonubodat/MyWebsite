# HTML keeps the Workers-assets default (max-age=0, must-revalidate => cheap ETag revalidation).
# Cloudflare merges matching rules, so Cache-Control is set only on the specific paths below, never on /*.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# content-hashed build output: cache forever
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# unhashed media: a day fresh, a week stale-while-revalidate
/hero/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/projects/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sonu-bodat-resume.pdf
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

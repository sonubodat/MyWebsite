---
import { site } from '../site';
const { title, description = `Apps by ${site.publisher}: support and legal pages.` } = Astro.props;
// Files in dev-site/public are served under /dev after the build, at the root in `astro dev`.
const base = import.meta.env.DEV ? '' : '/dev';
const fonts = [['Space Grotesk', 'space-grotesk', '300 700'], ['Manrope', 'manrope', '200 800'], ['DM Mono', 'dm-mono', '400']]
  .map(([family, file, weight]) => `@font-face{font-family:'${family}';src:url(${base}/fonts/${file}.woff2) format('woff2');font-weight:${weight};font-display:swap}`)
  .join('');
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const footer = [
  ['/about', 'About'], ['/contact', 'Contact'], ['/support', 'Support'],
  ['/privacy-policy', 'Privacy'], ['/terms', 'Terms'], ['/refund-policy', 'Refunds'],
  ['/delete-account', 'Delete account'], ['/grievance-officer', 'Grievance officer'],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={site.url + (path === '/' ? '' : path)}>
  <link rel="icon" href="/sonu-avatar.webp">
  <style is:inline set:html={fonts}></style>
</head>
<body>
  <header><a class="brand" href="/"><img src={`${base}/sonu-avatar.webp`} alt="" width="34" height="34">{site.publisher}</a><nav><a href="/support">Support</a><a href="/contact">Contact</a></nav></header>
  <main><slot /></main>
  <footer>
    <nav>{footer.map(([href, label]) => <a href={href}>{label}</a>)}</nav>
    <p>© {new Date().getFullYear()} {site.publisher}. This website sets no cookies and runs no analytics.</p>
  </footer>
</body>
</html>

<style is:global>
  /* Same tokens and type as the portfolio (portfolio/app/globals.css): bone + moss in light, ink + sage in dark. */
  :root { --bg: #efeee9; --fg: #070908; --muted: #56615b; --line: rgba(7, 9, 8, .16); --accent: #1e5240; --foot: #070908; --foot-fg: #9aa19d; --foot-accent: #9cc3ae; color-scheme: light dark;
    --serif: 'Space Grotesk', sans-serif; --sans: 'Manrope', system-ui, sans-serif; --mono: 'DM Mono', ui-monospace, monospace;
    --gutter: max(1.25rem, calc((100% - 46rem) / 2)); }
  @media (prefers-color-scheme: dark) { :root { --bg: #070908; --fg: #ecece7; --muted: #9aa19d; --line: rgba(236, 236, 231, .14); --accent: #9cc3ae; --foot: #040605; } }
  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; background: var(--bg); color: var(--fg); font: 1rem/1.65 var(--sans); overflow-wrap: break-word; }
  a { color: var(--accent); text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  header, footer nav { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; align-items: center; }
  header { justify-content: space-between; padding: 1.25rem var(--gutter); border-bottom: 1px solid var(--line); }
  header nav { display: flex; gap: 1.25rem; }
  header nav a, footer nav a { font: .72rem var(--mono); text-transform: uppercase; letter-spacing: .08em; text-decoration: none; }
  header nav a { color: var(--muted); }
  header nav a:hover, h3 a:hover { color: var(--accent); }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--fg); font: 700 1.05rem var(--serif); letter-spacing: -.04em; text-decoration: none; }
  .brand img { border-radius: 50%; object-fit: cover; }
  main { flex: 1; padding: 2.5rem var(--gutter) 4rem; }
  h1, h2, h3 { font-family: var(--serif); text-wrap: balance; }
  h1 { font-size: clamp(2.2rem, 7vw, 3.4rem); line-height: 1; letter-spacing: -.05em; margin: 1rem 0 1.25rem; }
  h2 { font-size: 1.45rem; line-height: 1.2; letter-spacing: -.03em; margin: 3rem 0 .75rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  h3 { font-size: 1.15rem; letter-spacing: -.02em; margin: 1.5rem 0 .25rem; }
  h3 a { color: var(--fg); text-decoration: none; }
  table { display: block; overflow-x: auto; border-collapse: collapse; font-size: .9rem; }
  th, td { border: 1px solid var(--line); padding: .55rem .7rem; text-align: left; vertical-align: top; min-width: 8rem; }
  th { font: .72rem var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
  .cards { list-style: none; padding: 0; margin: 1.25rem 0; }
  .cards li { border-top: 1px solid var(--line); padding: 1.1rem 0; }
  .cards li:last-child { border-bottom: 1px solid var(--line); }
  .cards h3 { margin: 0; }
  .cards p { margin: .35rem 0 0; }
  .muted { color: var(--muted); font-size: .9rem; }
  .who { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1rem; color: var(--muted); font-size: .9rem; }
  footer { background: var(--foot); color: var(--foot-fg); padding: 1.75rem var(--gutter) 2rem; }
  footer a { color: var(--foot-accent); }
  footer p { font: .68rem/1.7 var(--mono); margin: 1.25rem 0 0; }
</style>
